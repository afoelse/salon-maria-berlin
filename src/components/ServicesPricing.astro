---
import type { PriceGroup } from '../data/services';
interface Props { groups: PriceGroup[] }
const { groups } = Astro.props;

const icons: Record<PriceGroup['icon'], string> = {
  face: '<circle cx="20" cy="20" r="13" stroke="#6f8f3f" stroke-width="1.3"/><path d="M20 7 C20 14 16 18 12 20 C16 22 20 26 20 33" stroke="#6f8f3f" stroke-width="1.3" fill="none"/><path d="M20 7 C20 14 24 18 28 20 C24 22 20 26 20 33" stroke="#6f8f3f" stroke-width="1.3" fill="none"/>',
  massage: '<path d="M20 34 C20 24 20 14 20 6" stroke="#6f8f3f" stroke-width="1.3"/><ellipse cx="11" cy="22" rx="7" ry="3.6" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(35 11 22)"/><ellipse cx="29" cy="22" rx="7" ry="3.6" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(-35 29 22)"/><ellipse cx="14" cy="13" rx="6" ry="3.2" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(35 14 13)"/><ellipse cx="26" cy="13" rx="6" ry="3.2" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(-35 26 13)"/>',
  hands: '<path d="M20 6 C14 12 12 20 20 34 C28 20 26 12 20 6 Z" stroke="#6f8f3f" stroke-width="1.3" fill="none"/><path d="M20 12 V30" stroke="#6f8f3f" stroke-width="1.1"/>',
  extras: '<path d="M20 5 L23 16 L34 19 L23 22 L20 33 L17 22 L6 19 L17 16 Z" stroke="#6f8f3f" stroke-width="1.3" fill="none" stroke-linejoin="round"/><circle cx="31" cy="9" r="1.6" fill="#6f8f3f"/>',
};
---
<section class="lp-prices">
  {groups.map((group) => (
    <div class="price-group">
      <div class="price-group__head">
        <span class="icon">
          <svg width="40" height="40" viewBox="0 0 40 40" fill="none" aria-hidden="true" set:html={icons[group.icon]} />
        </span>
        <div>
          <h2>{group.title}</h2>
          <p>{group.subtitle}</p>
        </div>
      </div>
      <div class="price-table">
        {group.rows.map((row) => (
          <div class="price-row">
            <div class="price-row__main">
              <div class="price-row__name">{row.name}</div>
              {row.desc && <div class="price-row__desc">{row.desc}</div>}
            </div>
            <div class="price-row__dur">{row.dur ?? ''}</div>
            <div class="price-row__price">{row.price}</div>
          </div>
        ))}
      </div>
    </div>
  ))}
</section>

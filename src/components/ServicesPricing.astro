---
import type { PriceGroup } from '../data/services';
import type { UiDict } from '../i18n/ui';
interface Props { groups: PriceGroup[]; t: UiDict; bookingUrl: string }
const { groups, t, bookingUrl } = Astro.props;

const icons: Record<PriceGroup['icon'], string> = {
  face: '<circle cx="20" cy="20" r="13" stroke="currentColor" stroke-width="1.3"/><path d="M20 7 C20 14 16 18 12 20 C16 22 20 26 20 33" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M20 7 C20 14 24 18 28 20 C24 22 20 26 20 33" stroke="currentColor" stroke-width="1.3" fill="none"/>',
  massage: '<path d="M20 34 C20 24 20 14 20 6" stroke="currentColor" stroke-width="1.3"/><ellipse cx="11" cy="22" rx="7" ry="3.6" stroke="currentColor" stroke-width="1.3" fill="none" transform="rotate(35 11 22)"/><ellipse cx="29" cy="22" rx="7" ry="3.6" stroke="currentColor" stroke-width="1.3" fill="none" transform="rotate(-35 29 22)"/><ellipse cx="14" cy="13" rx="6" ry="3.2" stroke="currentColor" stroke-width="1.3" fill="none" transform="rotate(35 14 13)"/><ellipse cx="26" cy="13" rx="6" ry="3.2" stroke="currentColor" stroke-width="1.3" fill="none" transform="rotate(-35 26 13)"/>',
  hands: '<path d="M20 6 C14 12 12 20 20 34 C28 20 26 12 20 6 Z" stroke="currentColor" stroke-width="1.3" fill="none"/><path d="M20 12 V30" stroke="currentColor" stroke-width="1.1"/>',
  extras: '<path d="M20 5 L23 16 L34 19 L23 22 L20 33 L17 22 L6 19 L17 16 Z" stroke="currentColor" stroke-width="1.3" fill="none" stroke-linejoin="round"/><circle cx="31" cy="9" r="1.6" fill="currentColor"/>',
};
---
<section class="lp-menu" id="preise">
  <div class="lp-tabs" role="tablist" aria-label={t.leistungen.title}>
    {groups.map((group, i) => (
      <button
        type="button"
        role="tab"
        class="lp-tab"
        id={`tab-${group.icon}`}
        aria-controls={`panel-${group.icon}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        data-tab={group.icon}
      >
        <svg width="20" height="20" viewBox="0 0 40 40" fill="none" aria-hidden="true" set:html={icons[group.icon]} />
        {t.leistungen.tabs[group.icon]}
      </button>
    ))}
  </div>

  {groups.map((group) => (
    <div class="lp-panel" role="tabpanel" id={`panel-${group.icon}`} aria-labelledby={`tab-${group.icon}`} data-panel={group.icon}>
      <div class="lp-panel__head">
        <span class="lp-panel__icon">
          <svg width="34" height="34" viewBox="0 0 40 40" fill="none" aria-hidden="true" set:html={icons[group.icon]} />
        </span>
        <div>
          <h2>{group.title}</h2>
          <p>{group.subtitle}</p>
        </div>
        <span class="lp-panel__count">{group.rows.length} {t.leistungen.count}</span>
      </div>
      <ul class="menu-list">
        {group.rows.map((row) => (
          <li class="menu-item">
            <div class="menu-item__top">
              <span class="menu-item__name">{row.name}</span>
              <span class="menu-item__dots" aria-hidden="true"></span>
              <span class="menu-item__price">{row.price}</span>
            </div>
            {(row.desc || row.dur) && (
              <div class="menu-item__meta">
                {row.dur && (
                  <span class="menu-item__dur">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                    {row.dur}
                  </span>
                )}
                {row.desc && <span class="menu-item__desc">{row.desc}</span>}
              </div>
            )}
          </li>
        ))}
      </ul>
    </div>
  ))}

  <aside class="lp-advice">
    <div>
      <h3>{t.leistungen.adviceTitle}</h3>
      <p>{t.leistungen.adviceText}</p>
    </div>
    <a class="btn btn-primary" href={bookingUrl} target="_blank" rel="noopener"><svg width="18" height="18" aria-hidden="true"><use href="#ic-whatsapp"/></svg>{t.leistungen.adviceBtn}</a>
  </aside>
</section>

<script>
  (function () {
    var root = document.querySelector('.lp-menu');
    if (!root) return;
    var tabs = Array.prototype.slice.call(root.querySelectorAll<HTMLButtonElement>('.lp-tab'));
    var panels = Array.prototype.slice.call(root.querySelectorAll<HTMLElement>('.lp-panel'));
    root.classList.add('is-tabbed');

    function select(key: string, focus?: boolean) {
      tabs.forEach(function (tab: HTMLButtonElement) {
        var on = tab.dataset.tab === key;
        tab.setAttribute('aria-selected', on ? 'true' : 'false');
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach(function (panel: HTMLElement) {
        panel.hidden = panel.dataset.panel !== key;
      });
    }

    tabs.forEach(function (tab: HTMLButtonElement, i: number) {
      tab.addEventListener('click', function () {
        select(tab.dataset.tab!);
        tab.scrollIntoView({ block: 'nearest', inline: 'center', behavior: 'smooth' });
        history.replaceState(null, '', '#' + tab.dataset.tab);
      });
      tab.addEventListener('keydown', function (e: KeyboardEvent) {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        var next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next.dataset.tab!, true);
      });
    });

    var fromHash = location.hash.replace('#', '');
    var hashMatches = tabs.some(function (t: HTMLButtonElement) { return t.dataset.tab === fromHash; });
    select(hashMatches ? fromHash : tabs[0].dataset.tab!);
    // Coming from a treatment card on the home page: jump straight to the price list.
    if (hashMatches) root.scrollIntoView({ block: 'start' });
  })();
</script>

---
import type { UiDict } from '../i18n/ui';
interface Props { t: UiDict; bookingUrl: string; servicesHref: string }
const { t, bookingUrl, servicesHref } = Astro.props;
---
<section id="leistungen" class="services">
  <span class="eyebrow">{t.servicesPreview.eyebrow}</span>
  <h2>{t.servicesPreview.title}</h2>
  <div class="services__grid">
    <div class="card-svc">
      <div class="card-svc__icon">
        <svg width="42" height="42" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <circle cx="20" cy="20" r="13" stroke="#6f8f3f" stroke-width="1.3"/>
          <path d="M20 7 C20 14 16 18 12 20 C16 22 20 26 20 33" stroke="#6f8f3f" stroke-width="1.3" fill="none"/>
          <path d="M20 7 C20 14 24 18 28 20 C24 22 20 26 20 33" stroke="#6f8f3f" stroke-width="1.3" fill="none"/>
        </svg>
      </div>
      <h3>{t.servicesPreview.cards[0].title}</h3>
      <p>{t.servicesPreview.cards[0].text}</p>
    </div>
    <div class="card-svc">
      <div class="card-svc__icon">
        <svg width="42" height="42" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M20 34 C20 24 20 14 20 6" stroke="#6f8f3f" stroke-width="1.3"/>
          <ellipse cx="11" cy="22" rx="7" ry="3.6" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(35 11 22)"/>
          <ellipse cx="29" cy="22" rx="7" ry="3.6" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(-35 29 22)"/>
          <ellipse cx="14" cy="13" rx="6" ry="3.2" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(35 14 13)"/>
          <ellipse cx="26" cy="13" rx="6" ry="3.2" stroke="#6f8f3f" stroke-width="1.3" fill="none" transform="rotate(-35 26 13)"/>
        </svg>
      </div>
      <h3>{t.servicesPreview.cards[1].title}</h3>
      <p>{t.servicesPreview.cards[1].text}</p>
    </div>
    <div class="card-svc">
      <div class="card-svc__icon">
        <svg width="42" height="42" viewBox="0 0 40 40" fill="none" aria-hidden="true">
          <path d="M20 6 C14 12 12 20 20 34 C28 20 26 12 20 6 Z" stroke="#6f8f3f" stroke-width="1.3" fill="none"/>
          <path d="M20 12 V30" stroke="#6f8f3f" stroke-width="1.1"/>
        </svg>
      </div>
      <h3>{t.servicesPreview.cards[2].title}</h3>
      <p>{t.servicesPreview.cards[2].text}</p>
    </div>
  </div>
  <div class="services__actions">
    <a class="btn-outline" href={servicesHref}>{t.servicesPreview.all}</a>
    <a class="btn-primary" href={bookingUrl} target="_blank" rel="noopener">{t.servicesPreview.bookTreatwell}</a>
  </div>
</section>

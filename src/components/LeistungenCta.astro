---
import { treatwellUrl, type UiDict } from '../i18n/ui';
interface Props { t: UiDict; bookingUrl: string }
const { t, bookingUrl } = Astro.props;
---
<section class="cta-band">
  <div class="cta-band__inner">
    <img class="cta-band__logo" src="/assets/logo.png" alt="" width="64" height="64" loading="lazy" />
    <h2>{t.leistungen.ctaTitle}</h2>
    <p>{t.leistungen.ctaText}</p>
    <div class="cta-band__actions">
      <a class="btn btn-light btn--lg" href={bookingUrl} target="_blank" rel="noopener"><svg width="18" height="18" aria-hidden="true"><use href="#ic-whatsapp"/></svg>{t.leistungen.ctaBook}</a>
      <a class="btn btn-ghost-light btn--lg" href={treatwellUrl} target="_blank" rel="noopener">{t.leistungen.ctaTreatwell}</a>
    </div>
  </div>
</section>

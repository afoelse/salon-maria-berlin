---
import type { UiDict } from '../i18n/ui';
interface Props { t: UiDict; bookingUrl: string; contactHref: string }
const { t, bookingUrl, contactHref } = Astro.props;
---
<section class="cta-band">
  <div class="cta-band__inner">
    <img class="cta-band__logo" src="/assets/logo.png" alt="" width="64" height="64" loading="lazy" />
    <h2>{t.leistungen.ctaTitle}</h2>
    <p>{t.leistungen.ctaText}</p>
    <div class="cta-band__actions">
      <a class="btn btn-light btn--lg" href={bookingUrl} target="_blank" rel="noopener">{t.leistungen.ctaBook}</a>
      <a class="btn btn-ghost-light btn--lg" href={contactHref}>{t.leistungen.ctaContact}</a>
    </div>
  </div>
</section>

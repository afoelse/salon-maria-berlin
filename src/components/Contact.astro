---
import type { UiDict } from '../i18n/ui';
interface Props { t: UiDict }
const { t } = Astro.props;
---
<section id="kontakt" class="contact">
  <div class="contact__inner">
    <div class="contact__head">
      <span class="eyebrow">{t.contact.eyebrow}</span>
      <h2>{t.contact.title}</h2>
      <p>{t.contact.lead}</p>
    </div>
    <div class="contact__grid">
      <div class="contact__col">
        <div class="contact-card">
          <div class="contact-card__label">{t.contact.directLabel}</div>
          <a class="contact-line" href="tel:+4917610106022">
            <span class="icon-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l1.5 5-2 1.5a12 12 0 006 6l1.5-2 5 1.5v3a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke="#6f8f3f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><span class="k">{t.contact.mobileLabel}</span><span class="v">0176 10 10 60 22</span></span>
          </a>
          <a class="contact-line" href="tel:+49302824080">
            <span class="icon-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 4h3l1.5 5-2 1.5a12 12 0 006 6l1.5-2 5 1.5v3a2 2 0 01-2 2A16 16 0 013 6a2 2 0 012-2z" stroke="#6f8f3f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><span class="k">{t.contact.landlineLabel}</span><span class="v">030 28 24 080</span></span>
          </a>
          <a class="contact-line" href="mailto:kosmetik@mariafoelsener.com">
            <span class="icon-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18v12H3z" stroke="#6f8f3f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 7l9 6 9-6" stroke="#6f8f3f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span><span class="k">{t.contact.emailLabel}</span><span class="v v--mail">kosmetik@mariafoelsener.com</span></span>
          </a>
          <a class="btn-whatsapp" href="https://wa.me/4917610106022" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 21l1.8-5A8 8 0 1112 20a8 8 0 01-4-1l-5 2z" stroke="#fff" stroke-width="1.6" fill="none" stroke-linejoin="round"/><path d="M9 9c0 4 2 6 6 6 1-1 1-1.5.5-2.2-.5-.6-1.4-.9-2-.4-.7.6-1.9-.6-2.4-1.4-.4-.7 0-1.4.4-1.6C12 9 11.5 8 11 8 10 8 9 8 9 9z" fill="#fff"/></svg>
            {t.contact.whatsapp}
          </a>
        </div>
        <div class="contact-card hours-card">
          <div class="contact-card__label">{t.contact.hoursLabel}</div>
          {t.contact.days.map((d) => (
            <div class="hours-row"><span class="day">{d.day}</span><span class="time">{d.time}</span></div>
          ))}
          <p class="hours-note">{t.contact.hoursNote}</p>
        </div>
        <div class="contact-card addr-card">
          <div class="contact-card__label">{t.contact.addressLabel}</div>
          <div class="addr-row">
            <span class="icon-badge">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-6.4 7-11a7 7 0 10-14 0c0 4.6 7 11 7 11z" stroke="#6f8f3f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M12 10.5a2 2 0 100-4 2 2 0 000 4z" stroke="#6f8f3f" stroke-width="1.6" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
            <span>{t.contact.addressName}<br/>{t.contact.addressLines[0]}</span>
          </div>
          <div class="addr-social">
            <span class="lbl">{t.contact.followLabel}</span>
            <a href="https://instagram.com/mariafoelsenerkosmetik" target="_blank" rel="noopener"><svg width="17" height="17" aria-hidden="true"><use href="#ic-instagram"/></svg> Instagram</a>
            <a href="https://facebook.com/mariafoelsenerkosmetik" target="_blank" rel="noopener"><svg width="17" height="17" aria-hidden="true"><use href="#ic-facebook"/></svg> Facebook</a>
          </div>
        </div>
      </div>
      <div class="contact__map">
        <div class="map-consent" id="mapConsent" data-map-title={t.contact.mapTitle}>
          <svg width="30" height="30" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/></svg>
          <p>{t.contact.mapConsentText}</p>
          <button type="button" class="map-consent__btn" id="mapConsentBtn">{t.contact.mapConsentBtn}</button>
          <a class="map-consent__link" href="https://www.google.com/maps?q=Tieckstr.+1b,+10115+Berlin" target="_blank" rel="noopener">{t.contact.mapConsentLink}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById('mapConsentBtn');
  btn?.addEventListener('click', () => {
    const consent = document.getElementById('mapConsent');
    if (!consent) return;
    const title = consent.getAttribute('data-map-title') || 'Google Maps';
    const iframe = document.createElement('iframe');
    iframe.title = title;
    iframe.src = 'https://www.google.com/maps?q=Tieckstr.+1b,+10115+Berlin&output=embed';
    iframe.loading = 'lazy';
    iframe.setAttribute('style', 'width:100%;height:100%;border:0;display:block');
    consent.parentNode?.replaceChild(iframe, consent);
  });
</script>

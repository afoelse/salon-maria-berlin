---
import type { UiDict } from '../i18n/ui';
interface Props { t: UiDict; bookingUrl: string; servicesHref: string }
const { t, bookingUrl, servicesHref } = Astro.props;
---
<section id="hero" class="hero">
  <div class="hero__inner">
    <h1>
      <span class="pill">{t.hero.eyebrow}</span>
      <span class="hero__title">{t.hero.title[0]} <em>{t.hero.title[1]}</em></span>
    </h1>
    <p class="hero__sub">{t.hero.sub}</p>

    <div class="hero__actions">
      <a class="btn btn-primary btn--lg" href={bookingUrl} target="_blank" rel="noopener">
        <svg width="18" height="18" aria-hidden="true"><use href="#ic-whatsapp"/></svg>
        {t.hero.book}
      </a>
      <a class="btn btn-outline btn--lg" href={servicesHref}>{t.hero.view}</a>
    </div>

    <ul class="hero__facts">
      <li><span class="stars" aria-hidden="true">★★★★★</span>{t.hero.facts[0]}</li>
      <li>{t.hero.facts[1]}</li>
      <li>{t.hero.facts[2]}</li>
    </ul>
  </div>
</section>

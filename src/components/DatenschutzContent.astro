---
import type { Lang, UiDict } from '../i18n/ui';
interface Props { t: UiDict; lang: Lang }
const { t, lang } = Astro.props;
---
<main class="legal-page">
  <h1>{t.datenschutz.title}</h1>
  <p class="legal-sub">{t.datenschutz.sub}</p>

  {lang !== 'de' && (
    <div class="legal-note"><strong>Note:</strong> <span set:html={t.datenschutz.note} /></div>
  )}

  {t.datenschutz.sections.map((section: any) => (
    <>
      <h2>{section.h}</h2>
      {section.p.map((para: string) => <p set:html={para} />)}
      {section.ul && (
        <ul>
          {section.ul.map((item: string) => <li>{item}</li>)}
        </ul>
      )}
      {section.p2 && section.p2.map((para: string) => <p set:html={para} />)}
    </>
  ))}

  <p style="margin-top:32px;font-size:13px;color:var(--ink-muted)">{t.datenschutz.stand}</p>
</main>

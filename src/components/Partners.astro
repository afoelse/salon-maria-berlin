---
import type { UiDict } from '../i18n/ui';
interface Props { t: UiDict }
const { t } = Astro.props;

// Logos have very different aspect ratios (1.2:1 up to 6.5:1). Give each the
// same visual area instead of the same box, capped so none gets too tall/wide.
const AREA = 5600;
const MAX_W = 176;
const MAX_H = 62;
const logos = [
  { src: '/assets/brand-meentzen.webp', alt: 'Charlotte Meentzen', w: 281, h: 66 },
  { src: '/assets/brand-clarena.webp', alt: 'Clarena', w: 181, h: 113 },
  { src: '/assets/brand-denova.webp', alt: 'Denova Pro', w: 196, h: 148 },
  { src: '/assets/brand-grandel.webp', alt: 'Dr. Grandel', w: 520, h: 80 },
  { src: '/assets/brand-gehwol.webp', alt: 'Gehwol', w: 387, h: 75 },
  { src: '/assets/brand-primavera.webp', alt: 'Primavera', w: 638, h: 539 },
].map((logo) => {
  const ratio = logo.w / logo.h;
  let width = Math.sqrt(AREA * ratio);
  width = Math.min(width, MAX_W, MAX_H * ratio);
  return { ...logo, width: Math.round(width) };
});
---
<section class="partners">
  <div class="partners__inner">
    <span class="eyebrow">{t.partners.eyebrow}</span>
    <h2>{t.partners.title}</h2>
    <p class="partners__lead">{t.partners.lead}</p>
    <div class="partners__grid">
      {logos.map((logo) => (
        <div class="partners__logo">
          <img src={logo.src} alt={logo.alt} width={logo.w} height={logo.h} style={`width:${logo.width}px`} loading="lazy" />
        </div>
      ))}
    </div>
  </div>
</section>

---
import type { UiDict } from '../i18n/ui';
interface Props { t: UiDict }
const { t } = Astro.props;
const images = [
  { src: '/assets/studio-schaufenster.jpg', alt: t.gallery.alt.schaufenster },
  { src: '/assets/studio-behandlung.jpg', alt: t.gallery.alt.behandlung },
  { src: '/assets/studio-lounge.jpg', alt: t.gallery.alt.lounge },
  { src: '/assets/studio-flur.jpg', alt: t.gallery.alt.flur },
  { src: '/assets/studio-empfang.jpg', alt: t.gallery.alt.empfang },
  { src: '/assets/studio-fusspflege.jpg', alt: t.gallery.alt.fusspflege },
  { src: '/assets/studio-produkte.jpg', alt: t.gallery.alt.produkte },
  { src: '/assets/studio-eingang.jpg', alt: t.gallery.alt.eingang },
  { src: '/assets/studio-wartebereich.jpg', alt: t.gallery.alt.wartebereich },
];
---
<section class="gallery">
  <span class="eyebrow">{t.gallery.eyebrow}</span>
  <h2>{t.gallery.title}</h2>
  <div class="gallery__grid">
    {images.map((img) => (
      <figure><img src={img.src} alt={img.alt} loading="lazy" /></figure>
    ))}
  </div>
</section>

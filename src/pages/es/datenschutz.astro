---
import Layout from '../../layouts/Layout.astro';
import DatenschutzContent from '../../components/DatenschutzContent.astro';
import { ui } from '../../i18n/ui';

const lang = 'es' as const;
const t = ui[lang];
---
<Layout lang={lang} page="datenschutz" t={t} title={t.meta.datenschutzTitle} description={t.meta.datenschutzDesc} noindex>
  <DatenschutzContent t={t} lang={lang} />
</Layout>
